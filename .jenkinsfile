 pipeline {
    agent any

    environment {
        // Docker Hub credentials stored in Jenkins
        DOCKER_HUB_CREDENTIALS = credentials('docker-hub-credentials-id')
        IMAGE_NAME = "deepteshsingh/bookstore"
    }

    stages {
        stage('Checkout SCM') {
            steps {
                git(
                    url: 'https://github.com/deeptesh75/bookstore.git',
                    branch: 'deeptesh75',
                    credentialsId: 'docker-hub-credentials-id'
                )
            }
        }

        stage('Build JAR') {
            steps {
                sh 'chmod +x ./mvnw'
                sh './mvnw clean package -DskipTests'
            }
        }

        stage('Docker Login') {
            steps {
                sh "docker login -u ${DOCKER_HUB_CREDENTIALS_USR} -p ${DOCKER_HUB_CREDENTIALS_PSW}"
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    // Use Git commit hash for image tagging
                    def commitHash = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    env.DOCKER_TAG = "${commitHash}"
                }
                sh "docker build -t ${IMAGE_NAME}:${DOCKER_TAG} -t ${IMAGE_NAME}:latest ."
            }
        }

        stage('Push Docker Image') {
            steps {
                sh "docker push ${IMAGE_NAME}:${DOCKER_TAG}"
                sh "docker push ${IMAGE_NAME}:latest"
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline completed successfully!"
        }
        failure {
            echo "❌ Pipeline failed!"
        }
    }
}
