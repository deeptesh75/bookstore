pipeline {
    agent any
    environment {
        // Define variables for the Docker image name and credentials
        DOCKER_IMAGE_NAME = "your-docker-username/my-java-app"
        DOCKER_CREDS = credentials('your-docker-hub-credentials-id')
    }
    stages {
        stage('Checkout Code') {
            steps {
                git 'https://github.com/deeptesh75/bookstore.git'
            }
        }
        stage('Build & Test') {
            steps {
                // Use Maven to compile, test, and package the application
                sh 'mvn clean install'
            }
        }
        stage('Build & Push Docker Image') {
            steps {
                script {
                    // Build the Docker image and tag it with the unique build number
                    def customImage = docker.build("${DOCKER_IMAGE_NAME}:${env.BUILD_NUMBER}")
                    
                    // Log in to Docker Hub and push the image
                    docker.withRegistry('https://registry.hub.docker.com', DOCKER_CREDS) {
                        customImage.push()
                    }
                }
            }
        }
        stage('Deploy to Kubernetes') {
            steps {
                // Tell Kubernetes to update the deployment with the new image tag
                // This assumes kubectl is configured on the Jenkins agent
                sh "kubectl set image deployment/my-app-deployment my-app-container=${DOCKER_IMAGE_NAME}:${env.BUILD_NUMBER}"
            }
        }
    }
}