 pipeline {
    agent any

    environment {
        DOCKER_HUB_CREDENTIALS = credentials('docker-hub-credentials-id')
        IMAGE_NAME = "deepteshsingh/bookstore"
        DOCKER_PATH = "/usr/local/bin/docker"  // Path to Docker on macOS
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'deeptesh75',
                    url: 'https://github.com/deeptesh75/bookstore.git'
            }
        }

        stage('Build JAR') {
            steps {
                // Make mvnw executable
                sh 'chmod +x mvnw'
                sh './mvnw clean package -DskipTests'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    // Build Docker image using full Docker path
                    sh "${DOCKER_PATH} build -t ${IMAGE_NAME}:${BUILD_NUMBER} ."
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'docker-hub-credentials-id',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        // Login to Docker Hub
                        sh "${DOCKER_PATH} login -u $DOCKER_USER -p $DOCKER_PASS"
                        
                        // Push Docker images
                        sh "${DOCKER_PATH} push ${IMAGE_NAME}:${BUILD_NUMBER}"
                        sh "${DOCKER_PATH} tag ${IMAGE_NAME}:${BUILD_NUMBER} ${IMAGE_NAME}:latest"
                        sh "${DOCKER_PATH} push ${IMAGE_NAME}:latest"
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ Build and Docker Push successful!"
        }
        failure {
            echo "❌ Build failed!"
        }
    }
}
